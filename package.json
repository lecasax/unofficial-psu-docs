{
	"name": "unofficial-psu-docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"theme": "node scripts/theme.ts",
		"data": "node scripts/build-data.ts"
	},
	"devDependencies": {
		"@fontsource-variable/google-sans-flex": "^5.3.2",
		"@ktibow/iconset-material-symbols": "^0.0.1764827375",
		"@ktibow/material-color-utilities-nightly": "^0.4.1772748028000",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"m3-svelte": "^7.2.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-functions-mixins": "^0.4.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"vite-plugin-functions-mixins": {
			"vite": "$vite"
		}
	}
}
